#!/bin/bash
# dictate - toggle voice dictation into the focused window (KDE Plasma, Wayland)
#
#   dictate [toggle]   1st call: start recording from the default PipeWire
#                      source. 2nd call: stop, transcribe, type the text into
#                      the focused window via dotool (uinput).
#   dictate server     run whisper-server with the model loaded (used by the
#                      systemd user unit dictate-server.service).
#
# Transcription goes to the local whisper-server when it is running (the
# toggle starts dictate-server.service, so the model loads while you speak);
# if it is not reachable, whisper-cli is used instead.
#
# Configuration: /etc/dictate.conf, then ~/.config/dictate.conf.

set -u

MODELDIR=/usr/share/whisper-cpp/models

# Remember settings from the environment: they win over the config files.
# (declare -p without names would dump all variables.)
env_names=(${!DICTATE_*} ${!DOTOOL_XKB_*})
env_settings=
[ ${#env_names[@]} -gt 0 ] && env_settings=$(declare -p "${env_names[@]}")

# Defaults, see /etc/dictate.conf
DICTATE_MODEL=
DICTATE_LANG=auto
DICTATE_PROMPT=
DICTATE_OUTPUT=type
DICTATE_THREADS=$(( $(nproc) / 2 ))
DICTATE_SERVER=http://127.0.0.1:8178
DICTATE_SERVER_WAIT=30
DICTATE_AUDIO_CTX=auto
DICTATE_CHECK_FOCUS=1
DICTATE_DENY_CLASSES='plasmashell|org\.kde\.plasmashell|kscreenlocker_greet|krunner|org\.kde\.krunner'
DICTATE_SCRIPTS='Latin'
DICTATE_REJECT='спасибо|продолжение следует|untertitel (von|im auftrag|der amara)|amara\.org|fürs zuschauen|thanks? (you )?for watching'
DICTATE_MAX_REPEAT=4
DICTATE_DEBOUNCE=1
DOTOOL_XKB_LAYOUT=
DOTOOL_XKB_VARIANT=

for conf in /etc/dictate.conf "${XDG_CONFIG_HOME:-$HOME/.config}/dictate.conf"; do
	# shellcheck disable=SC1090
	[ -r "$conf" ] && . "$conf"
done
eval "$env_settings"

STATE=${XDG_RUNTIME_DIR:-/tmp}/dictate
mkdir -p "$STATE"
PIDFILE=$STATE/rec.pid
WAV=$STATE/rec.wav
NIDFILE=$STATE/notify.id
LOCKFILE=$STATE/lock
LASTFILE=$STATE/last
LOG=$STATE/log

log() {
	echo "$(date '+%F %T') $*" >>"$LOG"
}

# First existing model in order of preference
pick_model() {
	local m
	if [ -n "$DICTATE_MODEL" ]; then
		echo "$DICTATE_MODEL"
		return
	fi
	for m in ggml-large-v3-turbo.bin ggml-large-v3.bin; do
		[ -r "$MODELDIR/$m" ] && { echo "$MODELDIR/$m"; return; }
	done
	echo "dictate: no whisper model found in $MODELDIR" >&2
	return 1
}

# dotool needs the XKB layout to type umlauts and symbols correctly:
# KDE's own layout list first, then the system (localectl) layout.
detect_layout() {
	local kxkb=${XDG_CONFIG_HOME:-$HOME/.config}/kxkbrc layout= variant=
	[ -n "$DOTOOL_XKB_LAYOUT" ] && return
	if [ -r "$kxkb" ]; then
		layout=$(sed -n 's/^LayoutList=//p' "$kxkb" | cut -d, -f1)
		variant=$(sed -n 's/^VariantList=//p' "$kxkb" | cut -d, -f1)
	fi
	if [ -z "$layout" ]; then
		layout=$(localectl status 2>/dev/null | sed -n 's/^ *X11 Layout: //p' | cut -d, -f1)
		variant=$(localectl status 2>/dev/null | sed -n 's/^ *X11 Variant: //p' | cut -d, -f1)
	fi
	DOTOOL_XKB_LAYOUT=${layout:-us}
	DOTOOL_XKB_VARIANT=$variant
}

notify() {	# notify <icon> <text> [extra notify-send args]
	local icon=$1 text=$2; shift 2
	local rid=()
	[ -s "$NIDFILE" ] && rid=(-r "$(cat "$NIDFILE")")
	notify-send -a Dictate -i "$icon" -p "${rid[@]}" "$@" "Dictate" "$text" \
		> "$NIDFILE" 2>/dev/null
}

close_notify() {	# remove the "Transcribing…" notification
	[ -s "$NIDFILE" ] || return
	gdbus call --session -d org.freedesktop.Notifications \
		-o /org/freedesktop/Notifications \
		-m org.freedesktop.Notifications.CloseNotification \
		"$(cat "$NIDFILE")" >/dev/null 2>&1
	rm -f "$NIDFILE"
}

# Whisper always encodes a 30 s window (audio_ctx 1500 = 50/s). For short
# recordings a smaller window is much faster; below ~2.5x the recording
# length accuracy suffers. With whisper.cpp 1.9.5's Vulkan backend only
# multiples of 256 work (others produce garbage), so round up to those:
# 512 up to ~4 s, 768 up to ~6 s, 1024 up to ~8 s, 1280 up to ~10 s,
# then the full window (0).
audio_ctx() {
	local bytes ctx
	case $DICTATE_AUDIO_CTX in
	auto)
		bytes=$(stat -c %s "$WAV")
		ctx=$(( (bytes - 44) * 5 * 50 / 2 / 32000 ))	# 16 kHz s16 mono, x2.5
		ctx=$(( (ctx + 255) / 256 * 256 ))
		[ "$ctx" -lt 512 ] && ctx=512
		[ "$ctx" -gt 1280 ] && ctx=0
		echo "$ctx"
		;;
	*)
		echo "${DICTATE_AUDIO_CTX:-0}"
		;;
	esac
}

server_ready() {
	[ -n "$DICTATE_SERVER" ] &&
		curl -sf --max-time 1 "$DICTATE_SERVER/health" >/dev/null 2>&1
}

transcribe_server() {
	curl -sf --max-time 300 \
		-F "file=@$WAV" \
		--form-string response_format=text \
		--form-string no_timestamps=true \
		--form-string "audio_ctx=$(audio_ctx)" \
		--form-string "language=$DICTATE_LANG" \
		--form-string "prompt=$DICTATE_PROMPT" \
		"$DICTATE_SERVER/inference" 2>>"$LOG"
}

transcribe_cli() {
	local model
	model=$(pick_model 2>>"$LOG") || return 1
	whisper-cli -m "$model" -l "$DICTATE_LANG" -t "$DICTATE_THREADS" -ac "$(audio_ctx)" \
		--prompt "$DICTATE_PROMPT" -nt -np -f "$WAV" 2>>"$LOG"
}

active_window() {
	kdotool getactivewindow 2>/dev/null
}

screen_locked() {
	gdbus call --session -d org.freedesktop.ScreenSaver -o /ScreenSaver \
		-m org.freedesktop.ScreenSaver.GetActive 2>/dev/null | grep -q true
}

# Synthetic keys must reach a text window, never the desktop, the panel,
# the lock screen or another window than the one dictated into. Prints the
# reason and succeeds if typing is not safe.
focus_problem() {	# focus_problem <window focused when recording stopped>
	local win cls
	[ "$DICTATE_CHECK_FOCUS" = 1 ] || return 1
	if screen_locked; then
		echo "the screen is locked"
		return 0
	fi
	if ! command -v kdotool >/dev/null; then
		echo "kdotool is not installed, cannot check the focused window"
		return 0
	fi
	win=$(active_window)
	if [ -z "$win" ]; then
		echo "no window has the focus"
		return 0
	fi
	if [ -n "$1" ] && [ "$win" != "$1" ]; then
		echo "the focus moved to another window"
		return 0
	fi
	cls=$(kdotool getwindowclassname "$win" 2>/dev/null)
	if [ -z "$cls" ] || printf '%s\n' "$cls" | grep -qxE "$DICTATE_DENY_CLASSES"; then
		echo "the focused window (${cls:-unknown}) takes no text"
		return 0
	fi
	return 1
}

# Whisper invents text on silence or noise: subtitle credits, "thanks for
# watching", Russian "Спасибо", or one word looping. Prints the reason and
# succeeds if the transcript looks like such a hallucination.
hallucination() {	# hallucination <text>
	local t=$1 class='\p{Common}\p{Inherited}' s n
	if [ -n "$DICTATE_REJECT" ] && grep -qiE "$DICTATE_REJECT" <<<"$t"; then
		echo "known whisper hallucination"
		return 0
	fi
	if [ -n "$DICTATE_SCRIPTS" ]; then
		for s in $DICTATE_SCRIPTS; do class+="\\p{$s}"; done
		if grep -qP "[^$class]" <<<"$t"; then
			echo "characters outside the scripts $DICTATE_SCRIPTS"
			return 0
		fi
	fi
	if [ "${DICTATE_MAX_REPEAT:-0}" -gt 0 ]; then
		n=$(awk '{
			for (i = 1; i <= NF; i++) {
				w = tolower($i); gsub(/[[:punct:]]/, "", w)
				run = (w != "" && w == prev) ? run + 1 : 1
				if (run > max) max = run
				prev = w
			}
		} END { print max + 0 }' <<<"$t")
		if [ "$n" -ge "$DICTATE_MAX_REPEAT" ]; then
			echo "one word repeated $n times"
			return 0
		fi
	fi
	return 1
}

shortcuts_blocked() {	# shortcuts_blocked true|false
	gdbus call --session -d org.kde.kglobalaccel -o /kglobalaccel \
		-m org.kde.KGlobalAccel.blockGlobalShortcuts "$1" >/dev/null 2>&1
}

# Type (or paste) the text with global shortcuts blocked: if a modifier is
# still held, the synthetic keys would otherwise trigger shortcuts (with
# Meta held, every space is Meta+Space and toggles dictate again).
send_text() {	# send_text <text>
	local text=$1
	trap 'shortcuts_blocked false' EXIT
	trap 'exit 1' INT TERM HUP
	shortcuts_blocked true
	{
		# Release modifiers left over from the Meta+Space press
		printf 'keyup %s\n' leftmeta rightmeta leftctrl rightctrl \
			leftalt rightalt leftshift rightshift
		case $DICTATE_OUTPUT in
		paste)
			# wl-copy stays around to serve the clipboard: no lock fd
			printf '%s' "$text" | wl-copy 9>&-
			echo "key ctrl+v"
			;;
		*)
			# "type" takes the rest of the line; newlines already removed
			printf 'typedelay 4\ntypehold 4\ntype %s\n' "$text"
			;;
		esac
	} | dotool 2>>"$LOG"
	# Let KWin process the last key events before shortcuts are live again
	sleep 0.2
	shortcuts_blocked false
	trap - EXIT INT TERM HUP
}

now_ms() {
	date +%s%3N
}

start() {
	local last
	last=$(cat "$LASTFILE" 2>/dev/null)
	if [ -n "$last" ] && [ $(( $(now_ms) - last )) -lt $(( DICTATE_DEBOUNCE * 1000 )) ]; then
		log "toggle ignored: less than ${DICTATE_DEBOUNCE}s after the last dictation"
		return
	fi
	rm -f "$WAV" "$NIDFILE"
	# 9>&-: the recorder must not hold the toggle lock
	pw-record --rate 16000 --channels 1 --format s16 "$WAV" >>"$LOG" 2>&1 9>&- &
	echo $! > "$PIDFILE"
	notify audio-input-microphone "🎙 Recording… press Meta+Space to stop" -u critical
	# Load the model while the user speaks
	if [ -n "$DICTATE_SERVER" ] && ! server_ready; then
		systemctl --user start --no-block dictate-server.service >>"$LOG" 2>&1
	fi
}

stop() {
	local pid text i win= why
	pid=$(cat "$PIDFILE")
	rm -f "$PIDFILE"
	kill -INT "$pid" 2>/dev/null
	# The window the text is meant for: focused when the user stops
	[ "$DICTATE_CHECK_FOCUS" = 1 ] && win=$(active_window)
	while kill -0 "$pid" 2>/dev/null; do sleep 0.05; done

	if [ ! -s "$WAV" ] || [ "$(stat -c %s "$WAV")" -lt 16000 ]; then
		notify dialog-information "Recording too short – nothing typed" -t 2000
		return
	fi

	notify system-run "⏳ Transcribing…" -u critical

	text=
	if [ -n "$DICTATE_SERVER" ]; then
		# The server may still be loading the model
		for ((i = 0; i < DICTATE_SERVER_WAIT * 4; i++)); do
			server_ready && break
			case $(systemctl --user is-active dictate-server.service) in
			active|activating|reloading) ;;
			*) break ;;
			esac
			sleep 0.25
		done
		server_ready && text=$(transcribe_server)
	fi
	[ -z "$text" ] && text=$(transcribe_cli)

	text=$(printf '%s\n' "$text" |
		sed -e 's/\[[A-Z_ ]*\]//g' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' |
		grep -v '^$' | paste -sd ' ')

	if [ -z "$text" ]; then
		notify dialog-warning "No speech recognised" -t 3000
		return
	fi

	if why=$(hallucination "$text"); then
		log "rejected ($why): $text"
		notify dialog-warning "Nothing typed, $why: ${text:0:80}" -t 5000
		return
	fi

	if [ "$DICTATE_OUTPUT" = print ]; then
		printf '%s\n' "$text"
		close_notify
		return
	fi

	if why=$(focus_problem "$win"); then
		log "not typed ($why): $text"
		printf '%s' "$text" | wl-copy 9>&-
		notify edit-paste "Not typed, $why. The text is in the clipboard." -t 5000
		return
	fi

	detect_layout
	export DOTOOL_XKB_LAYOUT DOTOOL_XKB_VARIANT
	send_text "$text"
	close_notify
}

server() {
	local model hostport host port
	model=$(pick_model) || exit 1
	hostport=${DICTATE_SERVER#*://}
	hostport=${hostport%%/*}
	host=${hostport%:*}
	port=${hostport##*:}
	exec whisper-server -m "$model" -t "$DICTATE_THREADS" \
		--host "$host" --port "$port"
}

case ${1:-toggle} in
toggle)
	# One toggle at a time: a press while the previous one is still
	# transcribing or typing is dropped, not queued.
	exec 9>"$LOCKFILE"
	if ! flock -n 9; then
		log "toggle ignored: busy"
		exit 0
	fi
	if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		stop
		now_ms > "$LASTFILE"
	else
		start
	fi
	;;
server)
	server
	;;
*)
	echo "usage: dictate [toggle|server]" >&2
	exit 2
	;;
esac
